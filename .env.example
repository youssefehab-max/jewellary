# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---------------------------------------------------------------------------
# Paymob Accept (classic API: auth → order → payment key → iframe)
# Get these from the Paymob dashboard → Developers / Payment Integrations.
# ---------------------------------------------------------------------------
VITE_PAYMOB_API_KEY=your-paymob-api-key
VITE_PAYMOB_INTEGRATION_ID=your-card-integration-id
VITE_PAYMOB_IFRAME_ID=your-iframe-id

# Optional — used if you add server-side HMAC verification for callbacks
# VITE_PAYMOB_HMAC_SECRET=your-hmac-secret

# ---------------------------------------------------------------------------
# Paymob transaction response redirects (configure in Paymob dashboard):
#   Success URL → https://your-domain.com/order-success
#   Failure URL → https://your-domain.com/order-failed
# ---------------------------------------------------------------------------
